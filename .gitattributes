# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf

# Fonts — binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# JS/CSS/HTML — always LF (processed by Jekyll, must be consistent)
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Lock files
Gemfile.lock text eol=lf
